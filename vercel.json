{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "landing.html",
      "use": "@vercel/static"
    },
    {
      "src": "www/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/landing",
      "dest": "/landing.html"
    },
    {
      "src": "/app",
      "dest": "/www/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
