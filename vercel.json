{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "api/chat.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "landing.html",
      "use": "@vercel/static"
    },
    {
      "src": "app.html",
      "use": "@vercel/static"
    },
    {
      "src": "www/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/chat",
      "dest": "/api/chat.js"
    },
    {
      "src": "/style.css",
      "dest": "/www/style.css"
    },
    {
      "src": "/controller.js",
      "dest": "/www/controller.js"
    },
    {
      "src": "/main.js",
      "dest": "/www/main.js"
    },
    {
      "src": "/dist/(.*)",
      "dest": "/www/dist/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/www/assets/$1"
    },
    {
      "src": "/landing",
      "dest": "/landing.html"
    },
    {
      "src": "/app",
      "dest": "/www/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
